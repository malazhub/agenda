{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node scripts/prepare-pages.mjs && tsc --noEmit",
    "test:worker": "node --test cloudflare/worker.test.mjs",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.toml",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "cloudflare:migrate": "wrangler d1 migrations apply agenda-db --remote --config cloudflare/wrangler.toml",
    "cloudflare:migrate:local": "wrangler d1 migrations apply agenda-db --local --config cloudflare/wrangler.toml",
    "cloudflare:bootstrap-director": "node cloudflare/bootstrap-director.mjs",
    "cloudflare:seed-sessions": "node cloudflare/seed-sessions.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@stream-io/video-client": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
